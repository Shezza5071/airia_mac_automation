    "tools": [
      {
        "id": "da918322-d549-4a5f-be6f-d925c4c6db03",
        "toolType": "custom",
        "name": "alayacare_create_client_v6",
        "standardizedName": "alayacare_create_client_v6",
        "toolDescription": "Creates a new client in AlayaCare UAT. Returns integer id of the new client.",
        "purpose": "Create AlayaCare client with basic demographics and MAC ID",
        "apiEndpoint": "https://asa.uat.alayacare.com/ext/api/v2/patients/clients",
        "methodType": "POST",
        "bodyType": "Json",
        "body": "{\"demographics\":{\"first_name\":\"{{first_name}}\",\"last_name\":\"{{last_name}}\",\"gender\":\"{{gender}}\"},\"external_id\":\"{{external_id}}\",\"language\":\"{{language}}\",\"timezone\":\"{{timezone}}\",\"correspondence_method\":\"{{correspondence_method}}\"}",
        "headersDefinition": [
          {"key": "Authorization", "value": "Basic <YOUR_BASE64_ENCODED_ALAYACARE_CREDENTIALS>", "sensitive": true},
          {"key": "Content-Type", "value": "application/json", "sensitive": false}
        ],
        "credentialsDefinition": null,
        "credentialsSourceType": null,
        "routeThroughACC": false,
        "useUserCredentials": false,
        "parametersDefinition": [
          {"name": "first_name",            "parameterType": "string", "parameterDescription": "Client first name",                         "default": "", "requirement": "Required"},
          {"name": "last_name",             "parameterType": "string", "parameterDescription": "Client last name",                          "default": "", "requirement": "Optional"},
          {"name": "gender",                "parameterType": "string", "parameterDescription": "Gender code: M, F, or O",                   "default": "", "requirement": "Optional"},
          {"name": "external_id",           "parameterType": "string", "parameterDescription": "MAC Aged Care ID e.g. AC27413301",          "default": "", "requirement": "Optional"},
          {"name": "language",              "parameterType": "string", "parameterDescription": "ISO 639-1 language code e.g. en",           "default": "", "requirement": "Optional"},
          {"name": "timezone",              "parameterType": "string", "parameterDescription": "IANA timezone e.g. Australia/Adelaide",     "default": "", "requirement": "Optional"},
          {"name": "correspondence_method", "parameterType": "string", "parameterDescription": "Preferred contact method: mail or email",  "default": "", "requirement": "Optional"}
        ]
      },
      {
        "id": "fdd89efd-e6ec-45f4-9815-3b181b8d1cdc",
        "toolType": "custom",
        "name": "alayacare_update_demographics_v6",
        "standardizedName": "alayacare_update_demographics_v6",
        "toolDescription": "Updates demographics for an AlayaCare client. Use integer id from alayacare_create_client_v6 as client_id.",
        "purpose": "Update AlayaCare client DOB phone email address Medicare care needs",
        "apiEndpoint": "https://asa.uat.alayacare.com/ext/api/v2/patients/clients/{{client_id}}",
        "methodType": "PUT",
        "bodyType": "Json",
        "body": "{\"demographics\":{\"birthday\":\"{{birthday}}\",\"phone_personal\":\"{{phone_personal}}\",\"email\":\"{{email}}\",\"email_preferred\":\"{{email}}\",\"address\":\"{{address}}\",\"city\":\"{{city}}\",\"state\":\"{{state}}\",\"zip\":\"{{zip}}\",\"country\":\"AU\",\"health_card\":\"{{health_card}}\",\"care_needs\":\"{{care_needs}}\"}}",
        "headersDefinition": [
          {"key": "Authorization", "value": "Basic <YOUR_BASE64_ENCODED_ALAYACARE_CREDENTIALS>", "sensitive": true},
          {"key": "Content-Type", "value": "application/json", "sensitive": false}
        ],
        "credentialsDefinition": null,
        "credentialsSourceType": null,
        "routeThroughACC": false,
        "useUserCredentials": false,
        "parametersDefinition": [
          {"name": "client_id",      "parameterType": "string", "parameterDescription": "Integer client ID from alayacare_create_client_v6 response", "default": "", "requirement": "Required"},
          {"name": "birthday",       "parameterType": "string", "parameterDescription": "Date of birth YYYY-MM-DD",    "default": "", "requirement": "Required"},
          {"name": "phone_personal", "parameterType": "string", "parameterDescription": "Mobile phone number",         "default": "", "requirement": "Optional"},
          {"name": "email",          "parameterType": "string", "parameterDescription": "Email address",               "default": "", "requirement": "Optional"},
          {"name": "address",        "parameterType": "string", "parameterDescription": "Street address",              "default": "", "requirement": "Optional"},
          {"name": "city",           "parameterType": "string", "parameterDescription": "City or suburb",              "default": "", "requirement": "Optional"},
          {"name": "state",          "parameterType": "string", "parameterDescription": "State code e.g. SA",          "default": "", "requirement": "Optional"},
          {"name": "zip",            "parameterType": "string", "parameterDescription": "Postcode",                    "default": "", "requirement": "Optional"},
          {"name": "health_card",    "parameterType": "string", "parameterDescription": "Medicare number",             "default": "", "requirement": "Optional"},
          {"name": "care_needs",     "parameterType": "string", "parameterDescription": "Brief care needs summary",    "default": "", "requirement": "Optional"}
        ]
      },
      {
        "id": "5596a0ec-3a0e-45f3-8185-9ea895c9776b",
        "toolType": "custom",
        "name": "alayacare_self_contact_v6",
        "standardizedName": "alayacare_self_contact_v6",
        "toolDescription": "Creates a self-contact for the client. Use integer id from alayacare_create_client_v6 as client_id.",
        "purpose": "Create AlayaCare self-contact record",
        "apiEndpoint": "https://asa.uat.alayacare.com/ext/api/v2/contacts",
        "methodType": "POST",
        "bodyType": "Json",
        "body": "{\"client_id\":{{client_id}},\"contact_type\":\"Personal\",\"relationship\":\"Self\",\"demographics\":{\"first_name\":\"{{first_name}}\",\"last_name\":\"{{last_name}}\",\"phone_personal\":\"{{phone_personal}}\",\"email\":\"{{email}}\",\"address\":\"{{address}}\",\"city\":\"{{city}}\",\"state\":\"{{state}}\",\"zip\":\"{{zip}}\"}}",
        "headersDefinition": [
          {"key": "Authorization", "value": "Basic <YOUR_BASE64_ENCODED_ALAYACARE_CREDENTIALS>", "sensitive": true},
          {"key": "Content-Type", "value": "application/json", "sensitive": false}
        ],
        "credentialsDefinition": null,
        "credentialsSourceType": null,
        "routeThroughACC": false,
        "useUserCredentials": false,
        "parametersDefinition": [
          {"name": "client_id",      "parameterType": "integer", "parameterDescription": "Integer client ID no quotes",  "default": "", "requirement": "Required"},
          {"name": "first_name",     "parameterType": "string",  "parameterDescription": "Client first name",            "default": "", "requirement": "Required"},
          {"name": "last_name",      "parameterType": "string",  "parameterDescription": "Client last name",             "default": "", "requirement": "Optional"},
          {"name": "phone_personal", "parameterType": "string",  "parameterDescription": "Mobile phone number",          "default": "", "requirement": "Optional"},
          {"name": "email",          "parameterType": "string",  "parameterDescription": "Email address",                "default": "", "requirement": "Optional"},
          {"name": "address",        "parameterType": "string",  "parameterDescription": "Street address",               "default": "", "requirement": "Optional"},
          {"name": "city",           "parameterType": "string",  "parameterDescription": "City or suburb",               "default": "", "requirement": "Optional"},
          {"name": "state",          "parameterType": "string",  "parameterDescription": "State code e.g. SA",           "default": "", "requirement": "Optional"},
          {"name": "zip",            "parameterType": "string",  "parameterDescription": "Postcode",                     "default": "", "requirement": "Optional"}
        ]
      }
    ],
