    "tools": [
      {
        "id": "1ae3b507-3480-4c51-937c-6ec191d79a7d",
        "toolType": "custom",
        "name": "alayacare_create_client_v10",
        "standardizedName": "alayacare_create_client_v10",
        "toolDescription": "Creates a new AlayaCare client. Returns JSON with integer 'id' — use this as client_id for the other tools. Only pass name and gender here; all other fields go in alayacare_update_demographics_v10.",
        "purpose": "Create AlayaCare client record — name and gender only",
        "apiEndpoint": "https://asa.uat.alayacare.com/ext/api/v2/patients/clients",
        "methodType": "POST",
        "bodyType": "Json",
        "body": "{\"demographics\":{\"first_name\":\"{{first_name}}\",\"last_name\":\"{{last_name}}\",\"gender\":\"{{gender}}\"}}",
        "schemaDefinition": "{\"type\":\"object\",\"properties\":{\"first_name\":{\"type\":\"string\",\"description\":\"Client first name\"},\"last_name\":{\"type\":\"string\",\"description\":\"Client last name\"},\"gender\":{\"type\":\"string\",\"description\":\"M, F, or O\"}},\"required\":[\"first_name\",\"last_name\",\"gender\"]}",
        "headersDefinition": [
          {"key": "Authorization", "value": "Basic <YOUR_BASE64_ENCODED_ALAYACARE_CREDENTIALS>", "sensitive": true},
          {"key": "Content-Type", "value": "application/json", "sensitive": false}
        ],
        "credentialsDefinition": null,
        "credentialsSourceType": null,
        "routeThroughACC": false,
        "useUserCredentials": false,
        "parametersDefinition": [
          {"name": "first_name", "parameterType": "body", "parameterDescription": "Client first name",  "default": "", "requirement": "Required"},
          {"name": "last_name",  "parameterType": "body", "parameterDescription": "Client last name",   "default": "", "requirement": "Required"},
          {"name": "gender",     "parameterType": "body", "parameterDescription": "M, F, or O",         "default": "", "requirement": "Required"}
        ]
      },
      {
        "id": "785bf35f-039c-4dd5-9f54-10c8a9459e96",
        "toolType": "custom",
        "name": "alayacare_update_demographics_v10",
        "standardizedName": "alayacare_update_demographics_v10",
        "toolDescription": "Updates full demographics for an AlayaCare client. Pass the integer 'id' from alayacare_create_client_v10 as client_id.",
        "purpose": "Update full demographics including MAC ID, DOB, contact details, timezone, correspondence",
        "apiEndpoint": "https://asa.uat.alayacare.com/ext/api/v2/patients/clients/{{client_id}}",
        "methodType": "PUT",
        "bodyType": "Json",
        "body": "{\"external_id\":\"{{external_id}}\",\"timezone\":\"{{timezone}}\",\"correspondence_method\":\"{{correspondence_method}}\",\"demographics\":{\"birthday\":\"{{birthday}}\",\"phone_personal\":\"{{phone_personal}}\",\"email\":\"{{email}}\",\"email_preferred\":\"{{email}}\",\"address\":\"{{address}}\",\"city\":\"{{city}}\",\"state\":\"{{state}}\",\"zip\":\"{{zip}}\",\"country\":\"AU\",\"health_card\":\"{{health_card}}\",\"care_needs\":\"{{care_needs}}\"}}",
        "schemaDefinition": "{\"type\":\"object\",\"properties\":{\"client_id\":{\"type\":\"integer\",\"description\":\"Integer AlayaCare client ID from alayacare_create_client_v10\"},\"external_id\":{\"type\":\"string\",\"description\":\"MAC Aged Care ID e.g. AC27413301\"},\"birthday\":{\"type\":\"string\",\"description\":\"Date of birth YYYY-MM-DD\"},\"timezone\":{\"type\":\"string\",\"description\":\"IANA timezone e.g. Australia/Adelaide\"},\"correspondence_method\":{\"type\":\"string\",\"description\":\"mail or email\"},\"phone_personal\":{\"type\":\"string\",\"description\":\"Mobile phone number\"},\"email\":{\"type\":\"string\",\"description\":\"Email address\"},\"address\":{\"type\":\"string\",\"description\":\"Street address\"},\"city\":{\"type\":\"string\",\"description\":\"City or suburb\"},\"state\":{\"type\":\"string\",\"description\":\"State code e.g. SA\"},\"zip\":{\"type\":\"string\",\"description\":\"Postcode\"},\"health_card\":{\"type\":\"string\",\"description\":\"Medicare number\"},\"care_needs\":{\"type\":\"string\",\"description\":\"Brief care needs summary\"}},\"required\":[\"client_id\",\"external_id\",\"birthday\",\"timezone\",\"correspondence_method\"]}",
        "headersDefinition": [
          {"key": "Authorization", "value": "Basic <YOUR_BASE64_ENCODED_ALAYACARE_CREDENTIALS>", "sensitive": true},
          {"key": "Content-Type", "value": "application/json", "sensitive": false}
        ],
        "credentialsDefinition": null,
        "credentialsSourceType": null,
        "routeThroughACC": false,
        "useUserCredentials": false,
        "parametersDefinition": [
          {"name": "client_id",             "parameterType": "path", "parameterDescription": "Integer AlayaCare client ID from alayacare_create_client_v10",  "default": "", "requirement": "Required"},
          {"name": "external_id",           "parameterType": "body", "parameterDescription": "MAC Aged Care ID e.g. AC27413301",                              "default": "", "requirement": "Required"},
          {"name": "birthday",              "parameterType": "body", "parameterDescription": "Date of birth YYYY-MM-DD",                                      "default": "", "requirement": "Required"},
          {"name": "timezone",              "parameterType": "body", "parameterDescription": "IANA timezone e.g. Australia/Adelaide",                         "default": "", "requirement": "Required"},
          {"name": "correspondence_method", "parameterType": "body", "parameterDescription": "mail or email",                                                 "default": "", "requirement": "Required"},
          {"name": "phone_personal",        "parameterType": "body", "parameterDescription": "Mobile phone number",   "default": "", "requirement": "Optional"},
          {"name": "email",                 "parameterType": "body", "parameterDescription": "Email address",         "default": "", "requirement": "Optional"},
          {"name": "address",               "parameterType": "body", "parameterDescription": "Street address",        "default": "", "requirement": "Optional"},
          {"name": "city",                  "parameterType": "body", "parameterDescription": "City or suburb",        "default": "", "requirement": "Optional"},
          {"name": "state",                 "parameterType": "body", "parameterDescription": "State code e.g. SA",   "default": "", "requirement": "Optional"},
          {"name": "zip",                   "parameterType": "body", "parameterDescription": "Postcode",              "default": "", "requirement": "Optional"},
          {"name": "health_card",           "parameterType": "body", "parameterDescription": "Medicare number",       "default": "", "requirement": "Optional"},
          {"name": "care_needs",            "parameterType": "body", "parameterDescription": "Brief care needs summary", "default": "", "requirement": "Optional"}
        ]
      },
      {
        "id": "241df743-dc64-412b-9369-33b06bd2a315",
        "toolType": "custom",
        "name": "alayacare_self_contact_v10",
        "standardizedName": "alayacare_self_contact_v10",
        "toolDescription": "Creates a self-contact for the client. Pass the integer 'id' from alayacare_create_client_v10 as client_id.",
        "purpose": "Create AlayaCare self-contact record",
        "apiEndpoint": "https://asa.uat.alayacare.com/ext/api/v2/contacts",
        "methodType": "POST",
        "bodyType": "Json",
        "body": "{\"client_id\":{{client_id}},\"contact_type\":\"Personal\",\"relationship\":\"Self\",\"demographics\":{\"first_name\":\"{{first_name}}\",\"last_name\":\"{{last_name}}\",\"phone_personal\":\"{{phone_personal}}\",\"email\":\"{{email}}\",\"address\":\"{{address}}\",\"city\":\"{{city}}\",\"state\":\"{{state}}\",\"zip\":\"{{zip}}\"}}",
        "schemaDefinition": "{\"type\":\"object\",\"properties\":{\"client_id\":{\"type\":\"integer\",\"description\":\"Integer AlayaCare client ID from alayacare_create_client_v10\"},\"first_name\":{\"type\":\"string\",\"description\":\"Client first name\"},\"last_name\":{\"type\":\"string\",\"description\":\"Client last name\"},\"phone_personal\":{\"type\":\"string\",\"description\":\"Mobile phone number\"},\"email\":{\"type\":\"string\",\"description\":\"Email address\"},\"address\":{\"type\":\"string\",\"description\":\"Street address\"},\"city\":{\"type\":\"string\",\"description\":\"City or suburb\"},\"state\":{\"type\":\"string\",\"description\":\"State code e.g. SA\"},\"zip\":{\"type\":\"string\",\"description\":\"Postcode\"}},\"required\":[\"client_id\",\"first_name\"]}",
        "headersDefinition": [
          {"key": "Authorization", "value": "Basic <YOUR_BASE64_ENCODED_ALAYACARE_CREDENTIALS>", "sensitive": true},
          {"key": "Content-Type", "value": "application/json", "sensitive": false}
        ],
        "credentialsDefinition": null,
        "credentialsSourceType": null,
        "routeThroughACC": false,
        "useUserCredentials": false,
        "parametersDefinition": [
          {"name": "client_id",      "parameterType": "body", "parameterDescription": "Integer AlayaCare client ID from alayacare_create_client_v10",  "default": "", "requirement": "Required"},
          {"name": "first_name",     "parameterType": "body", "parameterDescription": "Client first name",    "default": "", "requirement": "Required"},
          {"name": "last_name",      "parameterType": "body", "parameterDescription": "Client last name",     "default": "", "requirement": "Optional"},
          {"name": "phone_personal", "parameterType": "body", "parameterDescription": "Mobile phone number",  "default": "", "requirement": "Optional"},
          {"name": "email",          "parameterType": "body", "parameterDescription": "Email address",        "default": "", "requirement": "Optional"},
          {"name": "address",        "parameterType": "body", "parameterDescription": "Street address",       "default": "", "requirement": "Optional"},
          {"name": "city",           "parameterType": "body", "parameterDescription": "City or suburb",       "default": "", "requirement": "Optional"},
          {"name": "state",          "parameterType": "body", "parameterDescription": "State code e.g. SA",  "default": "", "requirement": "Optional"},
          {"name": "zip",            "parameterType": "body", "parameterDescription": "Postcode",             "default": "", "requirement": "Optional"}
        ]
      }
    ],
