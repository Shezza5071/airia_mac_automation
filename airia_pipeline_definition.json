    "tools": [
      {
        "id": "4ce508fb-69a1-4dc9-9052-dde9550f7d1e",
        "toolType": "custom",
        "name": "alayacare_create_client_v9",
        "standardizedName": "alayacare_create_client_v9",
        "toolDescription": "Creates a new AlayaCare client. Returns JSON with integer 'id' â€” use this as client_id for the other tools. Only pass name and gender here; all other fields go in alayacare_update_demographics_v9.",
        "purpose": "Create AlayaCare client record â€” name and gender only",
        "apiEndpoint": "https://asa.uat.alayacare.com/ext/api/v2/patients/clients",
        "methodType": "POST",
        "bodyType": "Json",
        "body": "{\"demographics\":{\"first_name\":\"{{first_name}}\",\"last_name\":\"{{last_name}}\",\"gender\":\"{{gender}}\"}}",
        "headersDefinition": [
          {"key": "Authorization", "value": "Basic <YOUR_BASE64_ENCODED_ALAYACARE_CREDENTIALS>", "sensitive": true},
          {"key": "Content-Type", "value": "application/json", "sensitive": false}
        ],
        "credentialsDefinition": null,
        "credentialsSourceType": null,
        "routeThroughACC": false,
        "useUserCredentials": false,
        "parametersDefinition": [
          {"name": "first_name", "parameterType": "string", "parameterDescription": "Client first name",  "default": "", "requirement": "Required"},
          {"name": "last_name",  "parameterType": "string", "parameterDescription": "Client last name",   "default": "", "requirement": "Required"},
          {"name": "gender",     "parameterType": "string", "parameterDescription": "M, F, or O",         "default": "", "requirement": "Required"}
        ]
      },
      {
        "id": "b3a65283-2480-4e67-8211-a27eb910a1fa",
        "toolType": "custom",
        "name": "alayacare_update_demographics_v9",
        "standardizedName": "alayacare_update_demographics_v9",
        "toolDescription": "Updates full demographics for an AlayaCare client. Pass the integer 'id' from alayacare_create_client_v9 as client_id.",
        "purpose": "Update full demographics including MAC ID, DOB, contact details, timezone, correspondence",
        "apiEndpoint": "https://asa.uat.alayacare.com/ext/api/v2/patients/clients/{{client_id}}",
        "methodType": "PUT",
        "bodyType": "Json",
        "body": "{\"external_id\":\"{{external_id}}\",\"timezone\":\"{{timezone}}\",\"correspondence_method\":\"{{correspondence_method}}\",\"demographics\":{\"birthday\":\"{{birthday}}\",\"phone_personal\":\"{{phone_personal}}\",\"email\":\"{{email}}\",\"email_preferred\":\"{{email}}\",\"address\":\"{{address}}\",\"city\":\"{{city}}\",\"state\":\"{{state}}\",\"zip\":\"{{zip}}\",\"country\":\"AU\",\"health_card\":\"{{health_card}}\",\"care_needs\":\"{{care_needs}}\"}}",
        "headersDefinition": [
          {"key": "Authorization", "value": "Basic <YOUR_BASE64_ENCODED_ALAYACARE_CREDENTIALS>", "sensitive": true},
          {"key": "Content-Type", "value": "application/json", "sensitive": false}
        ],
        "credentialsDefinition": null,
        "credentialsSourceType": null,
        "routeThroughACC": false,
        "useUserCredentials": false,
        "parametersDefinition": [
          {"name": "client_id",             "parameterType": "string",  "parameterDescription": "Integer AlayaCare client ID from alayacare_create_client_v9",  "default": "", "requirement": "Required"},
          {"name": "external_id",           "parameterType": "string",  "parameterDescription": "MAC Aged Care ID e.g. AC27413301",                             "default": "", "requirement": "Required"},
          {"name": "birthday",              "parameterType": "string",  "parameterDescription": "Date of birth YYYY-MM-DD",                                     "default": "", "requirement": "Required"},
          {"name": "timezone",              "parameterType": "string",  "parameterDescription": "IANA timezone e.g. Australia/Adelaide",                        "default": "", "requirement": "Required"},
          {"name": "correspondence_method", "parameterType": "string",  "parameterDescription": "mail or email",                                                "default": "", "requirement": "Required"},
          {"name": "phone_personal",        "parameterType": "string",  "parameterDescription": "Mobile phone number",  "default": "", "requirement": "Optional"},
          {"name": "email",                 "parameterType": "string",  "parameterDescription": "Email address",        "default": "", "requirement": "Optional"},
          {"name": "address",               "parameterType": "string",  "parameterDescription": "Street address",       "default": "", "requirement": "Optional"},
          {"name": "city",                  "parameterType": "string",  "parameterDescription": "City or suburb",       "default": "", "requirement": "Optional"},
          {"name": "state",                 "parameterType": "string",  "parameterDescription": "State code e.g. SA",  "default": "", "requirement": "Optional"},
          {"name": "zip",                   "parameterType": "string",  "parameterDescription": "Postcode",             "default": "", "requirement": "Optional"},
          {"name": "health_card",           "parameterType": "string",  "parameterDescription": "Medicare number",      "default": "", "requirement": "Optional"},
          {"name": "care_needs",            "parameterType": "string",  "parameterDescription": "Brief care needs summary", "default": "", "requirement": "Optional"}
        ]
      },
      {
        "id": "7d981cd7-b006-4e01-99fb-4504c0a83b29",
        "toolType": "custom",
        "name": "alayacare_self_contact_v9",
        "standardizedName": "alayacare_self_contact_v9",
        "toolDescription": "Creates a self-contact for the client. Pass the integer 'id' from alayacare_create_client_v9 as client_id.",
        "purpose": "Create AlayaCare self-contact record",
        "apiEndpoint": "https://asa.uat.alayacare.com/ext/api/v2/contacts",
        "methodType": "POST",
        "bodyType": "Json",
        "body": "{\"client_id\":{{client_id}},\"contact_type\":\"Personal\",\"relationship\":\"Self\",\"demographics\":{\"first_name\":\"{{first_name}}\",\"last_name\":\"{{last_name}}\",\"phone_personal\":\"{{phone_personal}}\",\"email\":\"{{email}}\",\"address\":\"{{address}}\",\"city\":\"{{city}}\",\"state\":\"{{state}}\",\"zip\":\"{{zip}}\"}}",
        "headersDefinition": [
          {"key": "Authorization", "value": "Basic <YOUR_BASE64_ENCODED_ALAYACARE_CREDENTIALS>", "sensitive": true},
          {"key": "Content-Type", "value": "application/json", "sensitive": false}
        ],
        "credentialsDefinition": null,
        "credentialsSourceType": null,
        "routeThroughACC": false,
        "useUserCredentials": false,
        "parametersDefinition": [
          {"name": "client_id",      "parameterType": "integer", "parameterDescription": "Integer AlayaCare client ID from alayacare_create_client_v9",  "default": "", "requirement": "Required"},
          {"name": "first_name",     "parameterType": "string",  "parameterDescription": "Client first name",  "default": "", "requirement": "Required"},
          {"name": "last_name",      "parameterType": "string",  "parameterDescription": "Client last name",   "default": "", "requirement": "Optional"},
          {"name": "phone_personal", "parameterType": "string",  "parameterDescription": "Mobile phone number", "default": "", "requirement": "Optional"},
          {"name": "email",          "parameterType": "string",  "parameterDescription": "Email address",       "default": "", "requirement": "Optional"},
          {"name": "address",        "parameterType": "string",  "parameterDescription": "Street address",      "default": "", "requirement": "Optional"},
          {"name": "city",           "parameterType": "string",  "parameterDescription": "City or suburb",      "default": "", "requirement": "Optional"},
          {"name": "state",          "parameterType": "string",  "parameterDescription": "State code e.g. SA", "default": "", "requirement": "Optional"},
          {"name": "zip",            "parameterType": "string",  "parameterDescription": "Postcode",            "default": "", "requirement": "Optional"}
        ]
      }
    ],
