                             {
                                 "id":  "86c8b9fe-4453-4dbf-9f21-e5064cc32246",
                                 "code":  "import json\nimport requests\n\noutput = \"PENDING\"\n\nALAYACARE_BASE_URL = \"https://asa.uat.alayacare.com/ext/api/v2\"\nAUTH = \"Basic PLACEHOLDER_ALAYACARE_BASE64\"\nHEADERS = {\"Authorization\": AUTH, \"Content-Type\": \"application/json\"}\n\nif isinstance(input, dict):\n    client_data = input\nelse:\n    try:\n        client_data = json.loads(input)\n    except Exception as e:\n        output = \"ERROR: Could not parse input - \" + str(e)\n        print(output)\n        raise\n\nfirst_name = client_data.get(\"first_name\", \"\")\nlast_name = client_data.get(\"last_name\", \"\")\nexternal_id = client_data.get(\"external_id\", \"\")\n\nr1 = requests.post(ALAYACARE_BASE_URL + \"/patients/clients\", headers=HEADERS, json={\n    \"demographics\": {\"first_name\": first_name, \"last_name\": last_name, \"gender\": client_data.get(\"gender\", \"\")},\n    \"external_id\": external_id, \"language\": \"en\", \"timezone\": \"Australia/Adelaide\"\n})\nprint(\"Create client: \" + str(r1.status_code) + \" \" + r1.text)\nclient_id = r1.json().get(\"id\") if r1.ok else None\n\nif client_id:\n    r2 = requests.put(ALAYACARE_BASE_URL + \"/patients/clients/\" + str(client_id), headers=HEADERS, json={\n        \"demographics\": {\n            \"birthday\": client_data.get(\"birthday\", \"\"), \"phone_personal\": client_data.get(\"phone_personal\", \"\"),\n            \"phone_main\": client_data.get(\"phone_main\", \"\"), \"email\": client_data.get(\"email\", \"\"),\n            \"address\": client_data.get(\"address\", \"\"), \"city\": client_data.get(\"city\", \"\"),\n            \"state\": client_data.get(\"state\", \"\"), \"zip\": client_data.get(\"zip\", \"\"),\n            \"country\": \"AU\", \"health_card\": client_data.get(\"health_card\", \"\")\n        }\n    })\n    print(\"Update demographics: \" + str(r2.status_code) + \" \" + r2.text)\n\nif client_id:\n    r3 = requests.post(ALAYACARE_BASE_URL + \"/contacts\", headers=HEADERS, json={\n        \"client_id\": client_id, \"contact_type\": \"Personal\", \"relationship\": \"Self\",\n        \"demographics\": {\n            \"first_name\": first_name, \"last_name\": last_name,\n            \"phone_personal\": client_data.get(\"phone_personal\", \"\"), \"phone_main\": client_data.get(\"phone_main\", \"\"),\n            \"email\": client_data.get(\"email\", \"\"), \"address\": client_data.get(\"address\", \"\"),\n            \"city\": client_data.get(\"city\", \"\"), \"state\": client_data.get(\"state\", \"\"), \"zip\": client_data.get(\"zip\", \"\")\n        }\n    })\n    print(\"Create contact: \" + str(r3.status_code) + \" \" + r3.text)\n\nif client_id:\n    portal = \"https://asa.uat.alayacare.com/patients/clients/\" + str(client_id) + \"/details\"\n    output = (\n        \"Client created successfully in AlayaCare.\\n\\n\"\n        \"--- Client Details ---\\n\"\n        \"Name:          \" + first_name + \" \" + last_name + \"\\n\"\n        \"MAC ID:        \" + external_id + \"\\n\"\n        \"AlayaCare ID:  \" + str(client_id) + \"\\n\"\n        \"Date of Birth: \" + client_data.get(\"birthday\", \"\") + \"\\n\"\n        \"Gender:        \" + client_data.get(\"gender\", \"\") + \"\\n\"\n        \"Phone (Home):  \" + client_data.get(\"phone_main\", \"\") + \"\\n\"\n        \"Phone (Mobile):\" + client_data.get(\"phone_personal\", \"\") + \"\\n\"\n        \"Email:         \" + client_data.get(\"email\", \"\") + \"\\n\"\n        \"Address:       \" + client_data.get(\"address\", \"\") + \", \" + client_data.get(\"city\", \"\") + \" \" + client_data.get(\"state\", \"\") + \" \" + client_data.get(\"zip\", \"\") + \"\\n\"\n        \"Medicare:      \" + client_data.get(\"health_card\", \"\") + \"\\n\\n\"\n        \"Portal: \" + portal\n    )\nelif r1.status_code == 409:\n    output = \"WARNING: Client \" + external_id + \" already exists in AlayaCare. No new record created.\"\nelse:\n    output = \"FAILED: Could not create client for \" + external_id + \". Status: \" + str(r1.status_code)\n\nprint(output)",
