    "memories":  null,
    "pythonCodeBlocks":  [
                             {
                                 "id":  "aee58bb1-23e4-4542-8c28-d8cf57c4387c",
                                 "code":  "import requests\nimport json\n\nALAYACARE_BASE_URL = \"https://asa.uat.alayacare.com/ext/api/v2\"\nAUTH = \"Basic PLACEHOLDER_ALAYACARE_BASE64\"\nHEADERS = {\"Authorization\": AUTH, \"Content-Type\": \"application/json\"}\n\ntry:\n    client_data = json.loads(input)\nexcept Exception as e:\n    print(f\"Error parsing input: {e}\")\n    print(f\"Raw input: {repr(input)}\")\n    raise\n\n# Step 1: Create Client\nr1 = requests.post(f\"{ALAYACARE_BASE_URL}/patients/clients\", headers=HEADERS, json={\n    \"demographics\": {\"first_name\": client_data[\"first_name\"], \"last_name\": client_data[\"last_name\"], \"gender\": client_data[\"gender\"]},\n    \"external_id\": client_data[\"external_id\"], \"language\": \"en\", \"timezone\": \"Australia/Adelaide\"\n})\nprint(f\"Create client: {r1.status_code} {r1.text}\")\nclient_id = r1.json().get(\"id\") if r1.ok else None\n\n# Step 2: Update Demographics\nif client_id:\n    r2 = requests.put(f\"{ALAYACARE_BASE_URL}/patients/clients/{client_id}\", headers=HEADERS, json={\n        \"demographics\": {\n            \"birthday\": client_data.get(\"birthday\",\"\"), \"phone_personal\": client_data.get(\"phone_personal\",\"\"),\n            \"phone_main\": client_data.get(\"phone_main\",\"\"), \"email\": client_data.get(\"email\",\"\"),\n            \"address\": client_data.get(\"address\",\"\"), \"city\": client_data.get(\"city\",\"\"),\n            \"state\": client_data.get(\"state\",\"\"), \"zip\": client_data.get(\"zip\",\"\"),\n            \"country\": \"AU\", \"health_card\": client_data.get(\"health_card\",\"\")\n        }\n    })\n    print(f\"Update demographics: {r2.status_code} {r2.text}\")\n\n# Step 3: Create Contact\nif client_id:\n    r3 = requests.post(f\"{ALAYACARE_BASE_URL}/contacts\", headers=HEADERS, json={\n        \"client_id\": client_id, \"contact_type\": \"Personal\", \"relationship\": \"Self\",\n        \"demographics\": {\n            \"first_name\": client_data[\"first_name\"], \"last_name\": client_data[\"last_name\"],\n            \"phone_personal\": client_data.get(\"phone_personal\",\"\"), \"phone_main\": client_data.get(\"phone_main\",\"\"),\n            \"email\": client_data.get(\"email\",\"\"), \"address\": client_data.get(\"address\",\"\"),\n            \"city\": client_data.get(\"city\",\"\"), \"state\": client_data.get(\"state\",\"\"), \"zip\": client_data.get(\"zip\",\"\")\n        }\n    })\n    print(f\"Create contact: {r3.status_code} {r3.text}\")\n\nif client_id:\n    print(f\"SUCCESS: AlayaCare client ID={client_id}, Portal: https://asa.uat.alayacare.com/patients/clients/{client_id}/details\")\nelse:\n    print(\"FAILED: Could not create client\")",
                                 "isStructuredOutputEnabled":  false,
                                 "includeParsedFiles":  false
                             }
