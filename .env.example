# Copy this file to .env and fill in your credentials
# NEVER commit .env to version control

# AlayaCare instance (UAT or production)
ALAYACARE_SERVER=https://asa.uat.alayacare.com

# AlayaCare API credentials (from your AlayaCare admin)
ALAYACARE_USERNAME=your_api_username_here
ALAYACARE_PASSWORD=your_api_password_here

# Anthropic API key (for the Python script PDF extraction path)
ANTHROPIC_API_KEY=sk-ant-...
